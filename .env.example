# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- Gemini via Vertex AI (no API key; uses ADC / service-account auth) ---
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global              # Gemini 3.1 is global-endpoint only
GEMINI_MODEL=gemini-3.1-pro-preview

# --- Arize Phoenix Cloud (free tier) ---
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
PHOENIX_PROJECT_NAME=worldcup-agent
